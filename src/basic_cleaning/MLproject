name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:
      input_artifact:
        description: Name and version of the raw input artifact in W&B (e.g. sample.csv:latest)
        type: string
      output_artifact:
        description: Name of the cleaned output artifact to create in W&B
        type: string
      output_type:
        description: Type of the output artifact (e.g. clean_sample)
        type: string
      output_description:
        description: Short description of the output artifact
        type: string
      min_price:
        description: Minimum accepted nightly price (inclusive); cheaper listings are dropped
        type: float
      max_price:
        description: Maximum accepted nightly price (inclusive); pricier listings are dropped
        type: float

    command: >-
        python run.py --input_artifact {input_artifact} --output_artifact {output_artifact} --output_type {output_type} --output_description {output_description} --min_price {min_price} --max_price {max_price}
